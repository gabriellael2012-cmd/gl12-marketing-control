# Copie para .env (nunca commitado) ou configure como segredo do ambiente.

PORT=3001

# JSON completo da conta de serviço do Firebase Admin. Gerado em: Console do
# Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave
# privada. ESTE É UM SEGREDO DE VERDADE — nunca cole aqui no repositório nem
# em mensagem de chat. Configure como variável de ambiente segura do
# ambiente de execução.
#
# Aceita dois formatos:
# 1. O JSON bruto (precisa ficar em uma linha só — muitos campos de
#    variável de ambiente não aceitam colar texto com quebra de linha).
# 2. O mesmo JSON em base64 — mais fácil de colar porque vira um único
#    token sem quebra de linha, aspas ou chaves. No Windows (PowerShell):
#    [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho\do\arquivo.json")) | Set-Clipboard
#    No Mac/Linux: base64 -i caminho/do/arquivo.json | tr -d '\n' | pbcopy
FIREBASE_SERVICE_ACCOUNT=
