# Copie para .env (nunca commitado) ou configure como segredo do ambiente.

PORT=3001

# JSON completo da conta de serviço do Firebase Admin, em uma linha só.
# Gerado em: Console do Firebase > Configurações do projeto > Contas de serviço
# > Gerar nova chave privada. ESTE É UM SEGREDO DE VERDADE — nunca cole aqui
# no repositório nem em mensagem de chat. Configure como variável de ambiente
# segura do ambiente de execução.
FIREBASE_SERVICE_ACCOUNT=
