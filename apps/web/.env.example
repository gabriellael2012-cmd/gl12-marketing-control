# Copie para .env.local (nunca commitado) ou configure como variável de ambiente
# do ambiente de execução. Esses valores vêm do Console do Firebase do projeto
# (Configurações do projeto > Geral > Seus apps > SDK do Firebase).
# Não são segredos no sentido tradicional — a segurança do Firebase depende das
# regras do Firestore/Storage e do Firebase Authentication, não de esconder isso.
# Ainda assim, mantenha fora do código versionado por organização.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
